<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- DacFx rule assemblies load inside the SqlPackage/sqlproj build process, which runs
		     netstandard2.0 regardless of the TFM of the database project consuming them —
		     mirrors gen/Directory.Build.props' identical reasoning for Roslyn generators. -->
		<TargetFramework>netstandard2.0</TargetFramework>
		<IsPackable>true</IsPackable>
		<PackageId>Norse.$(MSBuildProjectName)</PackageId>
		<!-- Fixture scaffolding only — never actually published; throwaway local-feed pack in
		     Step 4's assertion group 3 is the only consumer. -->
		<IsAotCompatible>false</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.*" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<!-- Packed build/{PackageId}.targets — NuGet auto-imports this into any consumer that
		     takes a plain PackageReference to Norse.Scratch.Rules, no OutputItemType needed
		     (that machinery is ProjectReference-only). This is the package crossing's entire
		     enabling mechanism: doctrine the-runes.md ch. 8. -->
		<None Include="build/Norse.Scratch.Rules.targets" Pack="true" PackagePath="build/" />
	</ItemGroup>
</Project>
